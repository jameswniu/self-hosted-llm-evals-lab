        }
      ],
      "output_type": "generate_until",
      "generation_kwargs": {
        "until": [
          "\n\n"
        ],
        "max_gen_toks": 100,
        "temperature": 0.0,
        "do_sample": false
      },
      "repeats": 1,
      "filter_list": [
        {
          "name": "get_answer",
